# ── Auth Service — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in the real values.
# NEVER commit .env to git.

SERVER_PORT=8083

# MySQL / Database
DB_URL=jdbc:mysql://<host>:<port>/<database>?sslMode=REQUIRED&trustServerCertificate=true&allowPublicKeyRetrieval=true
DB_USERNAME=<db_username>
DB_PASSWORD=<db_password>

# JWT — must be at least 256 bits (32+ chars). Must match conversion-service exactly.
JWT_SECRET=<your_jwt_secret_key>
JWT_EXPIRATION=86400000

# Eureka Service Discovery
EUREKA_URL=http://localhost:8761/eureka/
